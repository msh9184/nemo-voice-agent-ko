# NeMo Voice Agent Client Configuration
#
# Copy this file to .env and modify as needed
#

# =============================================================================
# Server Connection Settings
# =============================================================================

# SERVER_HOST: Backend server address (WebSocket/API server)
#
# IMPORTANT: This is critical for team sharing!
#
# Scenario 1: Local development (localhost only)
#   - Leave empty to use window.location.hostname (default)
#   VITE_SERVER_HOST=
#
# Scenario 2: Team sharing via your PC as proxy
#   - Set to the GPU server's IP address that your SSH tunnel connects to
#   - Your PC acts as proxy: Team → Your PC:5173 → SSH tunnel → GPU server
#   - WebSocket needs direct route: Team → GPU server:8765
#   VITE_SERVER_HOST=10.xxx.xxx.xxx  (GPU server IP accessible from team PCs)
#
# Scenario 3: Direct GPU server access (if team can reach GPU directly)
#   VITE_SERVER_HOST=gpu-server-ip-or-hostname
#
VITE_SERVER_HOST=

# HTTPS mode: Enable HTTPS for team access through corporate networks
# - Set to 'true' to enable HTTPS (requires openssl installed)
# - Leave empty or 'false' for HTTP mode (local development)
#
VITE_HTTPS=false

# =============================================================================
# Language & Locale Settings
# =============================================================================

# Default language for transcription display
# Options: 'en' (English), 'ko' (Korean), 'auto' (Auto Detect)
#
VITE_DEFAULT_LANGUAGE=en

# =============================================================================
# Font & Typography Settings
# =============================================================================

# Default font style for STT display
#
# Korean Fonts:
#   'casual'      - Gowun Dodum (friendly, casual Korean) [RECOMMENDED for Korean]
#   'default'     - Pretendard (modern Korean-English hybrid)
#   'noto-sans'   - Noto Sans KR (clean, universal)
#   'elegant'     - Noto Serif KR (formal, elegant)
#   'nanum'       - Nanum Gothic (traditional Korean)
#   'handwriting' - Nanum Pen Script (handwritten style)
#   'playful'     - Gaegu (playful, comic style)
#
# English Fonts:
#   'courier'     - Courier New (classic monospace) [RECOMMENDED for English]
#   'consolas'    - Consolas (modern monospace)
#   'mono'        - JetBrains Mono (developer favorite)
#
VITE_DEFAULT_FONT=casual

# Default font size in pixels (14-32)
#
VITE_DEFAULT_FONT_SIZE=20

# =============================================================================
# Realtime STT Display Settings
# =============================================================================

# Maximum words per line before wrapping to next line
# This creates a smooth "flowing water" text effect
# Range: 5-50 (default: 15)
#
VITE_MAX_WORDS_PER_LINE=15

# =============================================================================
# Theme Settings
# =============================================================================

# Default theme
# Options: 'dark', 'light'
#
VITE_DEFAULT_THEME=dark
